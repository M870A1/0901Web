<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- 어노테이션을 스캔할 패키지 지정 -->
    <context:component-scan base-package="org.zerock.yesyes2" />

    <!-- Spring MVC 어노테이션 기반 컨트롤러를 사용하기 위한 설정 -->
    <mvc:annotation-driven />

    <!-- 정적 자원(CSS, JS, 이미지 등) 요청을 DispatcherServlet이 아닌 WAS의 기본 서블릿에게 위임 -->
    <mvc:resources mapping="/resources/**" location="/resources/" />
    <mvc:resources mapping="/CSS/**" location="/CSS/" />
    <mvc:resources mapping="/images/**" location="/images/" />

    <!-- View Resolver 설정: 컨트롤러에서 반환하는 논리적인 뷰 이름을 실제 JSP 파일 경로로 매핑 -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/" />
        <property name="suffix" value=".jsp" />
    </bean>

</beans>
